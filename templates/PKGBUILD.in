# Generated by therock_split.py. Edit the policy, not this file.
# Recipe source: {{recipe_repo_url}} ({{recipe_subdir}})
# Recipe attribution: {{recipe_author}}
# Recipe commit: {{recipe_commit}} ({{recipe_date}})

pkgbase='{{pkgbase}}'
pkgname=(
{{pkgname_block}}
)
pkgver='{{pkgver}}'
pkgrel={{pkgrel}}
arch=('x86_64')
license=({{license_block}})
url='{{url}}'
options=('!strip' 'staticlibs')
makedepends=('binutils' 'patchelf')
source=()
sha256sums=()

_recipe_repo_url='{{recipe_repo_url}}'
_recipe_subdir='{{recipe_subdir}}'
_recipe_author='{{recipe_author}}'
_recipe_commit='{{recipe_commit}}'
_recipe_date='{{recipe_date}}'

_therock_root="${_THEROCK_ROOT:-/}"
_generated_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_require_therock_root() {
    if [[ ! -d "${_therock_root}/opt/rocm" ]]; then
        echo "THEROCK_ROOT_MISSING: ${_therock_root}/opt/rocm" >&2
        echo "HINT: set _THEROCK_ROOT to the staged filesystem root containing opt/rocm" >&2
        return 1
    fi
}

_copy_from_filelist() {
    local pkg="$1"
    local filelist="${_generated_root}/filelists/${pkg}.txt"
    [[ -f "${filelist}" ]] || { echo "FILELIST_MISSING: ${filelist}" >&2; return 1; }
    while IFS= read -r rel; do
        [[ -n "${rel}" ]] || continue
        mkdir -p "${pkgdir}/$(dirname "${rel}")"
        (cd "${_therock_root}" && cp --parents -a --no-preserve=ownership "${rel}" "${pkgdir}")
    done < "${filelist}"
}

# Fail when a packaged ELF keeps a RUNPATH or RPATH entry outside /usr and
# /opt/rocm. $ORIGIN resolves against the object's installed directory, and an
# empty entry (the current directory) is foreign too. The generator runs the
# same check against the stage at render time.
_check_search_paths() {
    local file magic rel origin value entry resolved status=0
    local -a entries
    while IFS= read -r -d '' file; do
        magic=''
        IFS= read -r -N 4 magic < "${file}" 2>/dev/null || true
        [[ "${magic}" == $'\x7fELF' ]] || continue
        rel="${file#"${pkgdir}"}"
        origin="$(dirname "${rel}")"
        while IFS= read -r value; do
            IFS=':' read -r -a entries <<< "${value}"
            [[ "${value}" == *: ]] && entries+=('')
            for entry in "${entries[@]}"; do
                resolved="${entry}"
                case "${entry}" in
                    '$ORIGIN'|'$ORIGIN/'*) resolved="${origin}${entry#'$ORIGIN'}" ;;
                    '${ORIGIN}'|'${ORIGIN}/'*) resolved="${origin}${entry#'${ORIGIN}'}" ;;
                esac
                if [[ "${resolved}" == /* && "${resolved}" != *'$'* ]]; then
                    resolved="$(realpath -m -s -- "${resolved}")"
                    case "${resolved}" in
                        /usr|/usr/*|/opt/rocm|/opt/rocm/*) continue ;;
                    esac
                fi
                echo "FOREIGN_RUNPATH: ${rel}: '${entry}' in '${value}'" >&2
                status=1
            done
        done < <(LC_ALL=C readelf -d "${file}" | sed -n 's/.*(\(RUNPATH\|RPATH\)) *Library r[a-z]*path: \[\(.*\)\]$/\2/p')
    done < <(find "${pkgdir}" -type f -print0)
    return "${status}"
}

{{package_functions}}
