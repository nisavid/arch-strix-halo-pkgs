# Build tools for python-vllm-rocm-gfx1151 0.30.0 (W2A, #111).
# Resolve together with torch-chain.targets and model-closure.targets:
#   c_buildroot.py resolve --targets-file tools/buildroot/torch-chain.targets \
#     --targets-file tools/buildroot/model-closure.targets \
#     --targets-file tools/buildroot/vllm-build.targets ...
# vLLM's setup.py imports setuptools_rust, which imports semantic_version.
# The PKGBUILD names both as makedepends.
python-setuptools-rust
python-semantic-version
# python-setuptools-rust depends on rust. The version floor keeps a host rustup,
# which provides an unversioned `rust`, from standing in for the real toolchain;
# rustup would download one at build time. The vLLM build still skips its Rust
# extensions: build() sets CARGO=/usr/bin/false and RUSTUP_AUTO_INSTALL=0.
rust>=1:1.90

# Runtime closure for the in-root vLLM import and server smoke (#110, #111).
# The closure's W2A builds (Transformers, tokenizers, safetensors, mistral-common,
# pydantic-core, aiohttp, watchfiles and compressed-tensors) come from there.
# These are the Arch packages that python-vllm-rocm-gfx1151 depends on, plus the
# vLLM 0.30.0 requirements/common.txt entries that Arch packages and the
# depends do not name yet (regex, protobuf, tiktoken, partial-json-parser,
# python-json-logger, setproctitle, prometheus_client, the fastapi[standard]
# extras and OpenTelemetry). Pins that Arch cannot meet stay out: lark ==1.2.2,
# numba ==0.65.0, grpcio ==1.78.0 and mcp >=2.0.0,<3.0.0.
numactl
python-blake3
python-cachetools
python-cbor2
python-cloudpickle
python-fastapi
python-ijson
python-importlib-metadata
python-jsonschema
python-openai
python-opencv
python-pyzmq
python-soundfile
python-starlette
python-tqdm
uvicorn
python-regex
python-protobuf
python-tiktoken
python-partial-json-parser
python-json-logger
python-setproctitle
python-prometheus_client
python-httpx
python-python-multipart
python-email-validator
python-opentelemetry-sdk
python-opentelemetry-api
python-opentelemetry-exporter-otlp
# python-prometheus-fastapi-instrumentator-gfx1151 builds with poetry-core in
# the vLLM lease job.
python-poetry-core
# The small closure packages that the vLLM lease job builds before vLLM
# (#110, #111). uvloop and httptools compile Cython against the system libuv
# and llhttp. openai-harmony builds with maturin (and nasm and perl for its
# crates) on the rust target above. einops builds with hatchling; pybase64's
# setup.py drives cmake, which torch-chain.targets names.
cython
libuv
llhttp
nasm
python-maturin
python-hatchling
# apache-tvm-ffi and xgrammar build with scikit-build-core, which drives the
# cmake and ninja that torch-chain.targets names; apache-tvm-ffi also runs
# Cython (above) and setuptools-scm (torch-chain.targets). Neither needs
# nanobind: xgrammar 0.2.x binds through tvm-ffi.
python-scikit-build-core
# The inference scenario runner (tools/inference/runner.py) runs `ps` before
# each vLLM scenario to find stale engine cores, so in-root scenario runs need
# procps-ng; base-devel does not pull it in.
procps-ng
