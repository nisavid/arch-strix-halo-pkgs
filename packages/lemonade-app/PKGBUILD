_apply_patch_if_needed() {
  local _patch="$srcdir/$1"

  if [[ ! -f "${_patch}" ]]; then
    printf 'missing patch file: %s\n' "$1" >&2
    return 1
  fi

  if patch --dry-run -R -Np1 -i "${_patch}" >/dev/null 2>&1; then
    return 0
  fi

  patch -Np1 -i "${_patch}"
}

prepare() {
  cd "$srcdir/lemonade"

  _apply_patch_if_needed "0001-keep-tauri-glib-on-webkit-compatible-series.patch"
}

build() {
  cd "$srcdir/lemonade"

  _setup_compiler_env() {
  local _compiler_root="/opt/rocm/lib/llvm/bin"
  local _ccache_dir="$srcdir/.ccache/bin"
  local _ccache_cache="$srcdir/.ccache/cache"
  if command -v ccache >/dev/null 2>&1; then
    mkdir -p "${_ccache_dir}" "${_ccache_cache}"
    local _ccache_bin _name
    _ccache_bin="$(command -v ccache)"
    for _name in clang clang++ clang-22 amdclang amdclang++ hipcc hipcc.pl gcc g++ cc c++; do
      ln -sf "${_ccache_bin}" "${_ccache_dir}/${_name}"
    done
    export PATH="${_ccache_dir}:$PATH"
    export CCACHE_BASEDIR="$srcdir"
    export CCACHE_DIR="${_ccache_cache}"
    export CCACHE_NOCPP2=1
    export CCACHE_PATH="${_compiler_root}:/opt/rocm/bin:/usr/bin"
    export CC=amdclang
    export CXX=amdclang++
  else
    export CC="${_compiler_root}/amdclang"
    export CXX="${_compiler_root}/amdclang++"
  fi
}

  _build_jobs() {
  # Like GNU make, accept grouped short options (-kj4) and let the last job
  # option win; a bare -j (unlimited) or no job option falls back to nproc.
  local _jobs= _word _flags _i
  local -a _words
  read -ra _words <<<"${MAKEFLAGS:-}"
  for ((_i = 0; _i < ${#_words[@]}; _i++)); do
    _word=${_words[_i]}
    case $_word in
      --) break ;;
      --jobs=*) _jobs=${_word#--jobs=} ;;
      --jobs)
        _jobs=
        if [[ ${_words[_i + 1]:-} =~ ^[0-9]+$ ]]; then
          _i=$((_i + 1))
          _jobs=${_words[_i]}
        fi
        ;;
      --*) ;;
      -*)
        _flags=${_word#-}
        while [[ -n $_flags ]]; do
          case ${_flags:0:1} in
            j)
              _jobs=${_flags:1}
              if [[ -z $_jobs && ${_words[_i + 1]:-} =~ ^[0-9]+$ ]]; then
                _i=$((_i + 1))
                _jobs=${_words[_i]}
              fi
              break
              ;;
            [CfIoW])
              # These take an argument, attached or in the next word.
              if [[ -z ${_flags:1} ]]; then
                _i=$((_i + 1))
              fi
              break
              ;;
            [lO]) break ;;
          esac
          _flags=${_flags:1}
        done
        ;;
    esac
  done
  if [[ $_jobs =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "$_jobs"
  else
    nproc
  fi
}

  _setup_compiler_env
  local amdclang="$CC"
  local amdclangxx="$CXX"
  local build_root="$srcdir/build-lemonade-app"
  local install_root="/usr"
  local _debug_prefix="/usr/src/debug/lemonade-app"

  export HOME="$srcdir/.home"
  export XDG_CACHE_HOME="$srcdir/.cache"
  export XDG_DATA_HOME="$srcdir/.local/share"
  export CARGO_HOME="$srcdir/.cargo"
  export npm_config_cache="$srcdir/.npm-cache"
  export npm_config_update_notifier=false
  export RUSTFLAGS="--remap-path-prefix=$srcdir=${_debug_prefix}"
  mkdir -p "$HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$CARGO_HOME" "$npm_config_cache"

  rm -rf "${build_root}"
  cmake -B "${build_root}" -GNinja .     -DCMAKE_C_COMPILER="${amdclang}"     -DCMAKE_CXX_COMPILER="${amdclangxx}"     -DCMAKE_BUILD_TYPE=Release     -DCMAKE_INSTALL_PREFIX="${install_root}"     -DCMAKE_C_FLAGS="-O3 -march=native -famd-opt -Wno-error=unused-command-line-argument"     -DCMAKE_CXX_FLAGS="-O3 -march=native -famd-opt -Wno-error=unused-command-line-argument"     -DBUILD_ELECTRON_APP=OFF     -DBUILD_WEB_APP=OFF

  cmake --build "${build_root}" --target tauri-app -j"$(_build_jobs)"
}

package() {
  cd "$srcdir/lemonade"
  local build_root="$srcdir/build-lemonade-app"
  local _app_root="$pkgdir/usr/share/lemonade-app"
  local _tauri_output="${build_root}/app/lemonade-app"

  if [[ -f "${_tauri_output}" ]]; then
    install -Dm755 "${_tauri_output}" "${_app_root}/lemonade-app"
  else
    echo "LEMONADE_APP_OUTPUT_MISSING: expected Tauri binary at ${_tauri_output}" >&2
    echo "HINT: lemonade tauri-app currently writes to CMAKE_BINARY_DIR/app/lemonade-app on Linux; adjust the renderer if upstream changes this." >&2
    return 1
  fi

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/lemonade-app" <<'EOF'
#!/bin/sh
exec /usr/share/lemonade-app/lemonade-app "$@"
EOF

  if [[ -f data/lemonade-app.desktop ]]; then
    install -Dm644 data/lemonade-app.desktop "$pkgdir/usr/share/applications/lemonade-app.desktop"
  elif [[ -f data/lemonade-web-app.desktop ]]; then
    install -Dm644 data/lemonade-web-app.desktop "$pkgdir/usr/share/applications/lemonade-app.desktop"
  fi

  if [[ -f src/app/assets/logo.svg ]]; then
    install -Dm644 src/app/assets/logo.svg "$pkgdir/usr/share/pixmaps/lemonade-app.svg"
  fi

  install -Dm644 "$srcdir/lemonade/LICENSE" "$pkgdir/usr/share/licenses/lemonade-app/LICENSE"
}
