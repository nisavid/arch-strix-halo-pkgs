# Maintainer: nisavid

pkgname=python-transformers-gfx1151
pkgver=5.18.0
pkgrel=1
pkgdesc='State-of-the-art pretrained models for inference and training rebuilt for Strix Halo gfx1151'
arch=('any')
url='https://github.com/huggingface/transformers'
license=(Apache-2.0)
depends=(
  python-gfx1151
  # Transformers 5.18.0 requires huggingface-hub>=1.31.0,<3.0 and checks it
  # at import. Arch packages hub under epoch 1, so both bounds carry it.
  'python-huggingface-hub>=1:1.31.0'
  'python-huggingface-hub<1:3'
  python-numpy-gfx1151
  python-packaging
  python-regex
  python-safetensors-gfx1151
  python-tokenizers-gfx1151
  python-tqdm
  python-typer
  python-pyyaml-gfx1151
)
makedepends=(
  python-build
  python-installer
  python-setuptools
  python-wheel
)
optdepends=(
  'python-bitsandbytes: 8-bit support for PyTorch'
  'python-keras: support for models in Keras 3'
  'python-pytorch-opt-rocm-gfx1151: PyTorch support on the local ROCm lane'
)
options=()
provides=(python-transformers)
conflicts=(python-transformers)
replaces=()
source=(https://files.pythonhosted.org/packages/source/t/transformers/transformers-${pkgver}.tar.gz)
sha256sums=(d89c206e42e841af7cd314b3d2b21c03e977d819cdb4aef65ada048769a644df)

build() {
  cd "$srcdir/transformers-${pkgver}"
  export PYTHONPYCACHEPREFIX="$srcdir/.pycache"
  /usr/bin/python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/transformers-${pkgver}"
  export PYTHONPYCACHEPREFIX="$srcdir/.pycache"
  /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
}
