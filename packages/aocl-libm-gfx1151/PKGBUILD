pkgname=aocl-libm-gfx1151
pkgver=5.3
pkgrel=1
pkgdesc='AMD AOCL-LibM rebuilt with Zen 5 tuning for Strix Halo gfx1151'
arch=('x86_64')
url=https://github.com/amd/aocl-libm-ose.git
license=(BSD-3-Clause MIT Apache-2.0)
depends=(aocl-utils-gfx1151 gcc-libs glibc)
makedepends=(git patchelf python rocm-llvm-gfx1151 scons)
optdepends=()
options=()
provides=(aocl-libm)
conflicts=(aocl-libm)
replaces=()
source=('aocl-libm::git+https://github.com/amd/aocl-libm-ose.git#tag=5.3' 0001-scons-support-arch-amdclang-toolchain.patch)
sha256sums=(SKIP SKIP)

prepare() {
  cd "$srcdir/aocl-libm"

  patch -Np1 -i "$srcdir/0001-scons-support-arch-amdclang-toolchain.patch"
}

build() {
  cd "$srcdir/aocl-libm"

  _setup_compiler_env() {
  local _compiler_root="/opt/rocm/lib/llvm/bin"
  local _ccache_dir="$srcdir/.ccache/bin"
  local _ccache_cache="$srcdir/.ccache/cache"
  if command -v ccache >/dev/null 2>&1; then
    mkdir -p "${_ccache_dir}" "${_ccache_cache}"
    local _ccache_bin _name
    _ccache_bin="$(command -v ccache)"
    for _name in clang clang++ clang-22 amdclang amdclang++ hipcc hipcc.pl gcc g++ cc c++; do
      ln -sf "${_ccache_bin}" "${_ccache_dir}/${_name}"
    done
    export PATH="${_ccache_dir}:$PATH"
    export CCACHE_BASEDIR="$srcdir"
    export CCACHE_DIR="${_ccache_cache}"
    export CCACHE_NOCPP2=1
    export CCACHE_PATH="${_compiler_root}:/opt/rocm/bin:/usr/bin"
    export CC=amdclang
    export CXX=amdclang++
  else
    export CC="${_compiler_root}/amdclang"
    export CXX="${_compiler_root}/amdclang++"
  fi
}

  _build_jobs() {
  # Like GNU make, accept grouped short options (-kj4) and let the last job
  # option win; a bare -j (unlimited) or no job option falls back to nproc.
  local _jobs= _word _flags _i
  local -a _words
  read -ra _words <<<"${MAKEFLAGS:-}"
  for ((_i = 0; _i < ${#_words[@]}; _i++)); do
    _word=${_words[_i]}
    case $_word in
      --) break ;;
      --jobs=*) _jobs=${_word#--jobs=} ;;
      --jobs)
        _jobs=
        if [[ ${_words[_i + 1]:-} =~ ^[0-9]+$ ]]; then
          _i=$((_i + 1))
          _jobs=${_words[_i]}
        fi
        ;;
      --*) ;;
      -*)
        _flags=${_word#-}
        while [[ -n $_flags ]]; do
          case ${_flags:0:1} in
            j)
              _jobs=${_flags:1}
              if [[ -z $_jobs && ${_words[_i + 1]:-} =~ ^[0-9]+$ ]]; then
                _i=$((_i + 1))
                _jobs=${_words[_i]}
              fi
              break
              ;;
            [CfIoW])
              # These take an argument, attached or in the next word.
              if [[ -z ${_flags:1} ]]; then
                _i=$((_i + 1))
              fi
              break
              ;;
            [lO]) break ;;
          esac
          _flags=${_flags:1}
        done
        ;;
    esac
  done
  if [[ $_jobs =~ ^[1-9][0-9]*$ ]]; then
    printf '%s\n' "$_jobs"
  else
    nproc
  fi
}

  _setup_compiler_env
  local amdclang="/opt/rocm/lib/llvm/bin/amdclang"
  local amdclangxx="/opt/rocm/lib/llvm/bin/amdclang++"

  scons -j"$(_build_jobs)" \
    ALM_CC="${amdclang}" \
    ALM_CXX="${amdclangxx}" \
    --arch_config=avx512 \
    --aocl_utils_install_path=/usr \
    --aocl_utils_link=0
}

package() {
  cd "$srcdir/aocl-libm"

  install -dm755 "$pkgdir/usr/lib" "$pkgdir/usr/include"
  find build/aocl-release/src -name 'libalm*' -exec install -m755 {} "$pkgdir/usr/lib/" \;

  if [[ -f build/aocl-release/src/compat/glibc-compat.o ]]; then
    install -m644 build/aocl-release/src/compat/glibc-compat.o "$pkgdir/usr/lib/"
  fi

  if [[ -d include ]]; then
    cp -a --no-preserve=ownership include/. "$pkgdir/usr/include/"
  fi

  if [[ -f "$pkgdir/usr/lib/libalm.so" ]]; then
    patchelf --set-rpath /usr/lib "$pkgdir/usr/lib/libalm.so"
  fi
}
