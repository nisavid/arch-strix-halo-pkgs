pkgname=python-watchfiles-gfx1151
pkgver=1.2.0
pkgrel=1
pkgdesc='Simple, modern, and high-performance file watching rebuilt for Strix Halo gfx1151'
arch=('x86_64')
url=https://github.com/samuelcolvin/watchfiles
license=(MIT)
depends=(glibc libgcc python-gfx1151 python-anyio)
makedepends=(cargo python-build python-installer python-maturin python-wheel rocm-llvm-gfx1151 rust)
optdepends=()
options=()
provides=(python-watchfiles)
conflicts=(python-watchfiles)
replaces=()
source=(https://files.pythonhosted.org/packages/source/w/watchfiles/watchfiles-1.2.0.tar.gz)
sha256sums=(c995fba777f1ea992f090f9236e9284cf7a5d1a0130dd5a3d82c598cacd76838)

build() {
  cd "$srcdir/watchfiles-1.2.0"

  _setup_compiler_env() {
  local _compiler_root="/opt/rocm/lib/llvm/bin"
  local _ccache_dir="$srcdir/.ccache/bin"
  local _ccache_cache="$srcdir/.ccache/cache"
  if command -v ccache >/dev/null 2>&1; then
    mkdir -p "${_ccache_dir}" "${_ccache_cache}"
    local _ccache_bin _name
    _ccache_bin="$(command -v ccache)"
    for _name in clang clang++ clang-22 amdclang amdclang++ hipcc hipcc.pl gcc g++ cc c++; do
      ln -sf "${_ccache_bin}" "${_ccache_dir}/${_name}"
    done
    export PATH="${_ccache_dir}:$PATH"
    export CCACHE_BASEDIR="$srcdir"
    export CCACHE_DIR="${_ccache_cache}"
    export CCACHE_NOCPP2=1
    export CCACHE_PATH="${_compiler_root}:/opt/rocm/bin:/usr/bin"
    export CC=amdclang
    export CXX=amdclang++
  else
    export CC="${_compiler_root}/amdclang"
    export CXX="${_compiler_root}/amdclang++"
  fi
}

  _setup_compiler_env
  local _debug_prefix="/usr/src/debug/python-watchfiles-gfx1151"
  export HOME="$srcdir/.home"
  export XDG_CACHE_HOME="$srcdir/.cache"
  export XDG_DATA_HOME="$srcdir/.local/share"
  export CARGO_HOME="$srcdir/.cargo"
  mkdir -p "$HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$CARGO_HOME"
  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$CC"
  export RUSTFLAGS="-C target-cpu=znver5 -C opt-level=3 --remap-path-prefix=$srcdir=${_debug_prefix}"
  unset CFLAGS CXXFLAGS LDFLAGS

  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/watchfiles-1.2.0"
  python -m installer --destdir="$pkgdir" dist/*.whl

  local _debug_prefix="/usr/src/debug/python-watchfiles-gfx1151"
  find "$pkgdir/usr/lib" -type f -path '*/sboms/*.json' -print0 | while IFS= read -r -d '' _file; do
    sed -i       -e "s|$srcdir/watchfiles-1.2.0|${_debug_prefix}/watchfiles-1.2.0|g"       -e "s|$srcdir|${_debug_prefix}|g"       -e "s|/tmp/pkg/src/watchfiles-1.2.0|${_debug_prefix}/watchfiles-1.2.0|g"       "$_file" 2>/dev/null || true
  done
}
