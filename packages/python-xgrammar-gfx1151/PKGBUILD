pkgdesc='Structured generation grammar engine rebuilt for Strix Halo gfx1151'
arch=('x86_64')
url=https://github.com/mlc-ai/xgrammar
license=(Apache-2.0)
depends=(glibc libgcc libstdc++ python-apache-tvm-ffi-gfx1151 python-gfx1151 python-numpy-gfx1151 python-pydantic python-pytorch-opt-rocm-gfx1151 python-transformers-gfx1151 python-triton-gfx1151 python-typing_extensions)
