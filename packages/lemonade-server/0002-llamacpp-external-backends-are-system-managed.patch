+static std::string find_system_managed_external_backend(const std::string& recipe, const std::string& backend) {
+    if (recipe != "llamacpp") {
+        return "";
+    }
+    if (backend != "rocm" && backend != "vulkan") {
+        return "";
+    }
+    return BackendUtils::find_external_backend_binary(recipe, backend);
+}
+
+static std::string get_llamacpp_version_from_executable(const std::string& executable) {
+    std::string output;
+    try {
+        (void)lemon::utils::ProcessManager::run_process_with_output(
+            executable,
+            {"--version"},
+            [&output](const std::string& line) {
+                if (output.empty()) {
+                    output = line;
+                }
+                return false;
+            },
+            "",
+            5);
+    } catch (const std::exception&) {
+        return "unknown";
+    }
+
+    if (!output.empty()) {
+        std::regex version_regex(R"(version:\s*(\d+)|version\s+b?(\d+))");
+        std::smatch match;
+        if (std::regex_search(output, match, version_regex)) {
+            for (size_t i = 1; i < match.size(); ++i) {
+                if (match[i].matched) {
+                    return "b" + match[i].str();
+                }
+            }
+        }
+        return "detected";
+    }
+
+    return "unknown";
+}
+
 static std::string get_recipe_version(const std::string& recipe, const std::string& backend) {
+    std::string external_binary = find_system_managed_external_backend(recipe, backend);
+    if (!external_binary.empty()) {
+        return get_llamacpp_version_from_executable(external_binary);
+    }
