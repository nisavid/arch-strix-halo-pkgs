+static std::string get_system_managed_backend_message(const std::string& recipe, const std::string& backend) {
+    if (recipe == "llamacpp" && (backend == "rocm" || backend == "vulkan")) {
+        const char* label_env = std::getenv(
+            backend == "rocm" ? "LEMONADE_LLAMACPP_ROCM_LABEL" : "LEMONADE_LLAMACPP_VULKAN_LABEL");
+        if (label_env && *label_env) {
+            return label_env;
+        }
+        std::string external_binary = find_system_managed_external_backend(recipe, backend);
+        std::string binary_name = external_binary.empty() ? "backend" : fs::path(external_binary).filename().string();
+        std::string version = external_binary.empty() ? "unknown" : get_llamacpp_version_from_executable(external_binary);
+        if (!version.empty() && version != "unknown") {
+            return "System " + binary_name + " " + version;
+        }
+        return "System " + binary_name;
+    }
+    return "system-managed backend";
+}
