pkgname=lemonade-server
pkgver=11.7.0
pkgrel=1
pkgdesc='Local AI server runtime rebuilt for Strix Halo gfx1151'
arch=('x86_64')
url=https://github.com/nisavid/lemonade
license=(Apache-2.0)
depends=(glibc)
makedepends=(cmake git ninja nodejs npm rocm-llvm-gfx1151)
optdepends=('llama.cpp-hip-gfx1151: llama.cpp ROCm backend' 'llama.cpp-vulkan-gfx1151: llama.cpp Vulkan backend')
options=()
provides=(lemonade-server)
conflicts=()
