+
+        serve_module = vllm.entrypoints.cli.serve
+    else:
+        serve_module = _StaticHelpModule(
+            _StaticSubcommand(
+                "serve",
+                "Launch a local OpenAI-compatible API server to serve LLM completions via HTTP.",
+                "Launch a local OpenAI-compatible API server to serve LLM completions via HTTP.",
+                "vllm serve [model_tag] [options]",
+            ),
+        )
+
+    if selected == "launch":
+        import vllm.entrypoints.cli.launch
+
+        launch_module = vllm.entrypoints.cli.launch
+    else:
+        launch_module = _StaticHelpModule(
+            _StaticSubcommand(
+                "launch",
+                "Launch individual vLLM components.",
+                "Launch individual vLLM components.",
+                "vllm launch <component> [options]",
+            ),
+        )
+
+    if _should_load_benchmark_module():
+        import vllm.entrypoints.cli.benchmark.main
+
+        benchmark_module = vllm.entrypoints.cli.benchmark.main
+    else:
+        benchmark_module = _BenchHelpModule()
+
+    if selected == "collect-env":
+        import vllm.entrypoints.cli.collect_env
+
+        collect_env_module = vllm.entrypoints.cli.collect_env
+    else:
+        collect_env_module = _StaticHelpModule(
+            _StaticSubcommand(
+                "collect-env",
+                "Start collecting environment information.",
+                "Start collecting environment information.",
+                "vllm collect-env",
+            ),
+        )
+
+    if selected == "run-batch":
+        import vllm.entrypoints.cli.run_batch
+
+        run_batch_module = vllm.entrypoints.cli.run_batch
+    else:
+        run_batch_module = _StaticHelpModule(
+            _StaticSubcommand(
+                "run-batch",
+                "Run batch prompts and write results to file.",
+                "Run batch prompts using vLLM's OpenAI-compatible API.\nSupports local or HTTP input/output files.",
+                "vllm run-batch -i INPUT.jsonl -o OUTPUT.jsonl --model <model>",
+            ),
+        )
+
+    return [
+        openai_module,
+        serve_module,
+        launch_module,
+        benchmark_module,
+        collect_env_module,
+        run_batch_module,
+    ]
