+class _BenchHelpSubcommand:
+    name = "bench"
+    help = "vLLM bench subcommand."
+
+    @staticmethod
+    def cmd(args: argparse.Namespace) -> None:
+        import vllm.entrypoints.cli.benchmark.main
+
+        vllm.entrypoints.cli.benchmark.main.BenchmarkSubcommand.cmd(args)
+
+    def validate(self, args: argparse.Namespace) -> None:
+        return None
+
+    def subparser_init(
+        self, subparsers: argparse._SubParsersAction
+    ) -> argparse.ArgumentParser:
+        bench_parser = subparsers.add_parser(
+            self.name,
+            help=self.help,
+            description=self.help,
+            usage="vllm bench <bench_type> [options]",
+        )
+        bench_parser.set_defaults(dispatch_function=self.cmd)
+        return bench_parser
+
+
+class _BenchHelpModule:
+    @staticmethod
+    def cmd_init():
+        return [_BenchHelpSubcommand()]
+
+
+class _StaticSubcommand:
+    def __init__(
+        self,
+        name: str,
+        help: str,
+        description: str | None = None,
+        usage: str | None = None,
+    ) -> None:
+        self.name = name
+        self.help = help
+        self.description = description or help
+        self.usage = usage
+
+    @staticmethod
+    def cmd(args: argparse.Namespace) -> None:
+        raise RuntimeError("Static help subcommands should never be dispatched")
+
+    def validate(self, args: argparse.Namespace) -> None:
+        return None
+
+    def subparser_init(
+        self, subparsers: argparse._SubParsersAction
+    ) -> argparse.ArgumentParser:
+        return subparsers.add_parser(
+            self.name,
+            help=self.help,
+            description=self.description,
+            usage=self.usage,
+        )
+
+
+class _StaticHelpModule:
+    def __init__(self, *subcommands: _StaticSubcommand):
+        self._subcommands = list(subcommands)
+
+    def cmd_init(self):
+        return self._subcommands
+
+
+def _selected_subcommand() -> str | None:
+    if len(sys.argv) < 2:
+        return None
+
+    first_arg = sys.argv[1]
+    if first_arg in {"-h", "--help"} or first_arg.startswith("--help="):
+        return None
+
+    return first_arg
+
+
+def _load_cmd_modules():
+    selected = _selected_subcommand()
+
+    if selected in {"chat", "complete"}:
