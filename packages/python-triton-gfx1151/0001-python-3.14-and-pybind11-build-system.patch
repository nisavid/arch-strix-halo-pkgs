From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Strix Halo Packaging <packaging@example.invalid>
Date: Tue, 22 Sep 2026 00:00:00 +0000
Subject: [PATCH] Use Arch build tools in build-system requires

Keep the ROCm Triton 3.8 release build on the repo's Python 3.14 lane with
Arch-provided cmake, ninja and pybind11. Upstream pins `cmake==4.0` in
build-system.requires, which a no-isolation build rejects against Arch cmake.

The ast.Num hunk of the 3.0-era patch is upstream in 3.8 and is dropped.

---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
index 5843c83..b19e898 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -1,5 +1,5 @@
 [build-system]
-requires = ["setuptools>=40.8.0", "cmake==4.0", "ninja>=1.11.1", "pybind11>=2.13.1"]
+requires = ["setuptools>=40.8.0", "pybind11>=2.13.1"]
 build-backend = "setuptools.build_meta"
 
 [tool.mypy]
