pkgver=3.8.0+git669b31ac
pkgrel=1
pkgdesc='Language and compiler for custom deep-learning primitives, rebuilt from the ROCm Triton release lane for Strix Halo gfx1151'
arch=('x86_64')
url=https://triton-lang.org/main/index.html
license=(MIT)
depends=(glibc libgcc libstdc++ python-gfx1151 zlib)
makedepends=(cmake git ninja nlohmann-json pybind11 python-build python-installer python-setuptools python-wheel)
optdepends=()
options=()
provides=(python-triton=3.8.0+git669b31ac)
conflicts=(python-triton)
