source=('triton::git+https://github.com/ROCm/triton.git#commit=669b31acc1dd1b3fd93286afd5db67f65d9f7557' llvm-5f07f818-ubuntu-x64-1.tar.gz::https://oaitriton.blob.core.windows.net/public/llvm-builds/llvm-5f07f818-ubuntu-x64-1.tar.gz 0001-python-3.14-and-pybind11-build-system.patch 0002-disable-werror-with-therock-llvm-headers.patch)
sha256sums=(SKIP 62dd9524eed689360882a7ae06132182b4a724ca5dfdca77667556fcef940022 SKIP SKIP)

prepare() {
  cd "$srcdir/triton"

  patch -Np1 -i "$srcdir/0001-python-3.14-and-pybind11-build-system.patch"
  patch -Np1 -i "$srcdir/0002-disable-werror-with-therock-llvm-headers.patch"
}

build() {
  cd "$srcdir/triton"
  _setup_compiler_env() {
  local _compiler_root="/opt/rocm/lib/llvm/bin"
  local _ccache_dir="$srcdir/.ccache/bin"
  local _ccache_cache="$srcdir/.ccache/cache"
  if command -v ccache >/dev/null 2>&1; then
    mkdir -p "${_ccache_dir}" "${_ccache_cache}"
    local _ccache_bin _name
    _ccache_bin="$(command -v ccache)"
    for _name in clang clang++ clang-22 amdclang amdclang++ hipcc hipcc.pl gcc g++ cc c++; do
      ln -sf "${_ccache_bin}" "${_ccache_dir}/${_name}"
    done
    export PATH="${_ccache_dir}:$PATH"
    export CCACHE_BASEDIR="$srcdir"
    export CCACHE_DIR="${_ccache_cache}"
    export CCACHE_NOCPP2=1
    export CCACHE_PATH="${_compiler_root}:/opt/rocm/bin:/usr/bin"
    export CC=amdclang
    export CXX=amdclang++
  else
    export CC="${_compiler_root}/amdclang"
    export CXX="${_compiler_root}/amdclang++"
  fi
}

  _setup_compiler_env
  export ROCM_HOME="/opt/rocm"
  export ROCM_PATH="/opt/rocm"
  # Offline build: LLVM comes from the pinned source tarball, nlohmann-json
  # from the system, and nothing else is downloaded.
  export TRITON_OFFLINE_BUILD=ON
  export LLVM_SYSPATH="$srcdir/llvm-5f07f818-ubuntu-x64-1"
  export JSON_SYSPATH=/usr
  export TRITON_HOME="$srcdir/.triton-home"
  # Each libtriton and triton-* tool link pulls in static LLVM and MLIR.
  export TRITON_PARALLEL_LINK_JOBS="${TRITON_PARALLEL_LINK_JOBS:-2}"
  export TRITON_BUILD_PROTON=OFF
  if command -v ccache >/dev/null 2>&1; then
    export TRITON_BUILD_WITH_CCACHE=true
  else
    unset TRITON_BUILD_WITH_CCACHE
  fi

  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/triton"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 "$srcdir/triton/LICENSE" "$pkgdir/usr/share/licenses/python-triton-gfx1151/LICENSE"
}
