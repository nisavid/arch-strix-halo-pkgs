pkgname=python-httptools-gfx1151
pkgver=0.8.0
pkgrel=1
pkgdesc='Fast HTTP parser rebuilt for Strix Halo gfx1151'
arch=('x86_64')
url=https://github.com/MagicStack/httptools
license=(MIT)
depends=(llhttp python-gfx1151)
makedepends=(cython python-build python-installer python-setuptools python-wheel rocm-llvm-gfx1151)
optdepends=()
options=()
provides=(python-httptools)
conflicts=(python-httptools)
replaces=()
source=(https://files.pythonhosted.org/packages/source/h/httptools/httptools-0.8.0.tar.gz 0001-use-system-llhttp.patch)
sha256sums=(6b2a32f18d97e16e90827d7a819ffa8dbd8cc245fc4e1fa9d1095b54ef4bd999 db5c625c08b481c8f85dbb598eb394fee089f360f5b2f056d18bb253d5c36b44)

prepare() {
  cd "$srcdir/httptools-0.8.0"

  if ! patch --dry-run -R -Np1 -i "$srcdir/0001-use-system-llhttp.patch" >/dev/null 2>&1; then
    patch -Np1 -i "$srcdir/0001-use-system-llhttp.patch"
  fi
}

build() {
  cd "$srcdir/httptools-0.8.0"

  _setup_compiler_env() {
  local _compiler_root="/opt/rocm/lib/llvm/bin"
  local _ccache_dir="$srcdir/.ccache/bin"
  local _ccache_cache="$srcdir/.ccache/cache"
  if command -v ccache >/dev/null 2>&1; then
    mkdir -p "${_ccache_dir}" "${_ccache_cache}"
    local _ccache_bin _name
    _ccache_bin="$(command -v ccache)"
    for _name in clang clang++ clang-22 amdclang amdclang++ hipcc hipcc.pl gcc g++ cc c++; do
      ln -sf "${_ccache_bin}" "${_ccache_dir}/${_name}"
    done
    export PATH="${_ccache_dir}:$PATH"
    export CCACHE_BASEDIR="$srcdir"
    export CCACHE_DIR="${_ccache_cache}"
    export CCACHE_NOCPP2=1
    export CCACHE_PATH="${_compiler_root}:/opt/rocm/bin:/usr/bin"
    export CC=amdclang
    export CXX=amdclang++
  else
    export CC="${_compiler_root}/amdclang"
    export CXX="${_compiler_root}/amdclang++"
  fi
}

  _setup_compiler_env
  local _base_flags="-O3 -march=native -mprefer-vector-width=512 -mavx512f -mavx512dq -mavx512vl -mavx512bw -mllvm -enable-gvn-hoist -mllvm -enable-gvn-sink -Wno-error=unused-command-line-argument"
  local _wheel_flags
  _wheel_flags="$(printf '%s' "${_base_flags}" | sed -E 's/-mllvm (-[^ ]+)/-Xclang -mllvm -Xclang \1/g; s/  +/ /g; s/^ +| +$//g')"
  local _base_cflags="${CFLAGS:-}"
  local _base_cxxflags="${CXXFLAGS:-}"
  local _base_ldflags="${LDFLAGS:-}"

  export CFLAGS="${_base_cflags:+${_base_cflags} }${_wheel_flags}"
  export CXXFLAGS="${_base_cxxflags:+${_base_cxxflags} }${_wheel_flags}"
  export LDFLAGS="${_base_ldflags:+${_base_ldflags} }-famd-opt"

  /usr/bin/python -m build --wheel --no-isolation --skip-dependency-check
}

package() {
  cd "$srcdir/httptools-0.8.0"
  /usr/bin/python -m installer --destdir="$pkgdir" dist/*.whl
}
